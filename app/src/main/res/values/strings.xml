    <!-- Accessibility -->
    <string name="guardian_label">NightLatch Guardian</string>
    <string name="guardian_description">Active only while a NightLatch alarm is ringing: brings you back to the alarm if you try to leave it (Settings, force stop, uninstall, notification shade, power menu). Phone and emergency calls are always allowed. It reads only the name of the app in the foreground, never screen content.</string>

    <!-- Setup wizard -->
    <string name="setup_title">SETUP</string>
    <string name="setup_intro">A few permissions are needed so the alarm rings on time, over the lock screen, and can be dismissed with your tags. Tap each FIX button, then come back here.</string>
    <string name="setup_required">Required</string>
    <string name="setup_recommended">Recommended</string>
    <string name="setup_notif_desc">Shows the alarm while it is ringing.</string>
    <string name="setup_fullscreen_desc">Opens the alarm screen over the lock screen.</string>
    <string name="setup_exact_desc">Makes the alarm ring at the exact time.</string>
    <string name="setup_nfc">NFC on</string>
    <string name="setup_nfc_desc">Needed to dismiss the alarm with your tags.</string>
    <string name="setup_guardian_desc">Optional: stops you from closing the app or opening Settings while the alarm rings.</string>
    <string name="setup_done">START</string>
    <string name="setup_skip">CONTINUE ANYWAY</string>
    <string name="setup_skip_hint">Without the required permissions the alarm may not ring or may not show up. You can fix them later in CONFIG.</string>
    <string name="perm_missing_title">Missing permission</string>
    <string name="perm_missing_text">%1$s: tap to turn it back on. Android removed it (it can happen after an update).</string>

