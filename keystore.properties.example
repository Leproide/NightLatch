# NightLatch - NFC alarm clock
# Author: https://github.com/Leproide
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Release signing. Copy to keystore.properties (git-ignored) and fill in.
# Create a keystore with:
#   keytool -genkeypair -v -keystore nightlatch.jks -keyalg RSA -keysize 4096 -validity 10000 -alias nightlatch
# storeFile is relative to the project root, or absolute. Keep the keystore OUTSIDE the repo.
# Windows: use forward slashes (backslash is an escape character in .properties files),
#   e.g. storeFile=D:/Keys/nightlatch.jks
# A PKCS12 keystore (keytool default) uses the same password for store and key.

storeFile=nightlatch.jks
storePassword=CHANGE_ME
keyAlias=nightlatch
keyPassword=CHANGE_ME
